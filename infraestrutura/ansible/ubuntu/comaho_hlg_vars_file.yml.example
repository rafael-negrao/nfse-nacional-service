# Variáveis do deploy da biblioteca — copie para comaho_hlg_vars_file.yml e preencha o token.
#
# O arquivo real NÃO é versionado: pode carregar um token do GitHub, e este repositório fica no
# próprio GitHub. Ver 00.instrucoes.md.
#
# Uma biblioteca não tem banco, SMTP nem serviço — por isso a lista é bem menor que a das
# aplicações. O deploy termina no ~/.m2 do app_user.

app_user: "ubuntu"
github_repo: "github.com/rafael-negrao/nfse-nacional-service.git"
# O repositório é público — deixe vazio. Preencha só se ele passar a privado.
github_token: ""
source_dir: "/home/ubuntu/nfse-nacional-service"
